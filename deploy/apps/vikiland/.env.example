# Copia in /srv/apps/vikiland/.env sul server (NON committare il file vero).
#
# Dominio pubblico dell'app. Deve avere un record DNS A verso l'IP del server.
APP_HOST=vikiland.ESEMPIO.it
# Password del database dedicato: generala con `openssl rand -hex 24`.
POSTGRES_PASSWORD=CAMBIAMI
# Tag dell'immagine in produzione: la CI lo riscrive a ogni deploy.
IMAGE_TAG=latest
